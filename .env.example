NODE_ENV=development
PORT=3001
# Minimal 32 byte acak. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Recommended stable 32+ byte key for encrypting aspiration content at rest.
# If omitted, the encryption key is derived from JWT_SECRET; keep unchanged while records exist.
# ASPIRATION_ENCRYPTION_KEY=
# Optional stable key for encrypting dashboard-recoverable e-ticket secrets. Keep unchanged while tickets are valid.
# EVENT_TICKET_ENCRYPTION_KEY=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_PUBLIC_REGISTRATION=false
INITIAL_ADMIN_NIM=admin
# Minimal 16 karakter. Hanya dipakai saat SQLite baru dibuat tanpa impor data/database.json.
INITIAL_ADMIN_PASSWORD=
# Optional e-ticket email via Resend; dashboard and browser QR remain available without these.
# RESEND_API_KEY=
# EVENT_EMAIL_FROM=HMIF Events <events@example.org>
# Set absolute paths outside the workspace in production.
# DATABASE_FILE=
# ASSET_STORAGE_DIR=

# =============================================================================
# FITUR: Single Sign-On (SSO) – Google OAuth2
# Buat credentials di: https://console.cloud.google.com/apis/credentials
# Tambahkan Authorized redirect URI: http://localhost:3001/api/auth/sso/google/callback
# =============================================================================
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/sso/google/callback
# FRONTEND_SSO_SUCCESS=http://localhost:5173/
# FRONTEND_SSO_ERROR=http://localhost:5173/login?sso_error=1

# =============================================================================
# FITUR: Web Push Notifications (VAPID)
# Generate otomatis jika kosong (tapi subscription akan hilang saat restart).
# Generate manual: node -e "const wp=await import('web-push'); console.log(wp.default.generateVAPIDKeys())"
# =============================================================================
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=admin@hmif-umb.ac.id
