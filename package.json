{
  "name": "hmif-umb-web",
  "version": "4.2.0",
  "description": "Portal Resmi HMIF Universitas Mayasari Bakti dengan antarmuka taktis PRTS",
  "author": "HMIF Universitas Mayasari Bakti",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "test:e2e": "playwright test",
    "smoke:release": "node scripts/release-smoke.js",
    "check:bundle": "node scripts/check-bundle-size.js",
    "check:release": "npm test && npm run build && npm run check:bundle && npm run smoke:release && npm run test:e2e"
  },
  "keywords": [
    "hmif",
    "mayasari-bakti",
    "prts",
    "arknights",
    "tactical-terminal"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "livekit-client": "^2.24.0",
    "livekit-server-sdk": "^2.19.3",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "vite": "^8.3.1"
  }
}
